{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Fast Tests",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pytest", "-v"],
      "problemMatcher": ["$pytest"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run Integration Tests (opt-in)",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pytest", "src\\integration_tests", "-v", "--tb=short"],
      "problemMatcher": ["$pytest"],
      "group": "test"
    },
    {
      "label": "Lint with Ruff",
      "type": "shell",
      "command": "python",
      "args": ["-m", "ruff", "check", "src", "scripts"],
      "problemMatcher": []
    },
    {
      "label": "Format with Black",
      "type": "shell",
      "command": "python",
      "args": ["-m", "black", "src", "scripts", "--line-length", "100"],
      "problemMatcher": []
    },
    {
      "label": "Type Check",
      "type": "shell",
      "command": "python",
      "args": ["-m", "mypy", "src", "scripts", "--ignore-missing-imports"],
      "problemMatcher": []
    },
    {
      "label": "Security Audit (Bandit)",
      "type": "shell",
      "command": "python",
      "args": ["-m", "bandit", "-r", "src", "scripts", "-ll"],
      "problemMatcher": []
    },
    {
      "label": "Run Main Pipeline",
      "type": "shell",
      "command": "python",
      "args": ["-m", "main"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
