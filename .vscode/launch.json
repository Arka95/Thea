{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Main Pipeline",
      "type": "python",
      "request": "launch",
      "module": "main",
      "console": "integratedTerminal",
      "justMyCode": false,
      "stopOnEntry": false
    },
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Fast Tests",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Integration Tests (opt-in)",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": ["src\\integration_tests", "-v", "-s"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Profile Memory",
      "type": "python",
      "request": "launch",
      "module": "memory_profiler",
      "args": ["${file}"],
      "console": "integratedTerminal"
    }
  ]
}
