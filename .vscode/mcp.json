{
  "servers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ],
      "cwd": "${workspaceFolder}"
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "cwd": "${workspaceFolder}"
    },
    "seq-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@gotza02/seq-thinking"
      ],
      "cwd": "${workspaceFolder}"
    },
    "git": {
      "type": "stdio",
      "command": "${workspaceFolder}\\.venv\\Scripts\\mcp-server-git.exe",
      "args": [
        "--repository",
        "${workspaceFolder}"
      ],
      "cwd": "${workspaceFolder}"
    }
  }
}
